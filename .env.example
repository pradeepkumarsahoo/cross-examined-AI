# CrossExam local settings. Copy to .env (scripts\setup.cmd / make setup) and fill in the key.
# Every value here overrides the default in app/config.py; delete a line to use the default.
# docker-compose.yml sets DATABASE_URL, REDIS_URL, LOCAL_STORAGE_DIR and API_URL itself.

# --- LLM ---------------------------------------------------------------------------
# gemini (API key) | vertex (GCP project, no key) | openai | fake (tests only)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# GCP_PROJECT=
# GCP_LOCATION=us-central1

# Model tiers. Check https://ai.google.dev/models for current IDs before relying on them.
MODEL_SMALL=gemini-3.5-flash-lite
MODEL_MID=gemini-3.8-flash
MODEL_STRONG=gemini-3.8-flash
MODEL_FALLBACK=gemini-3.1-flash-lite
MODEL_VISION=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001

# USD per 1M tokens, {"model": [input, output]}. Placeholders: set from the current price list.
MODEL_PRICES_JSON={"default": [0.10, 0.40]}

# One Redis token bucket shared by every worker.
LLM_REQUESTS_PER_MINUTE=60

# --- guard rails and business rules ---------------------------------------------------
CONFIDENCE_THRESHOLD=0.80
MANAGER_APPROVAL_THRESHOLD_INR=500000
MIN_SHELF_LIFE_DAYS=180

# --- observability ---------------------------------------------------------------------
LOG_LEVEL=INFO
# none | console | otlp | gcp
OTEL_EXPORTER=none
# none | prometheus | gcp
METRICS_EXPORTER=prometheus

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=crossexam

# --- running outside Docker (defaults shown) ---------------------------------------------
# DATABASE_URL=postgresql+psycopg://crossexam:crossexam@localhost:5432/crossexam
# REDIS_URL=redis://localhost:6379/0
# LOCAL_STORAGE_DIR=./data/storage
# API_URL=http://localhost:8000
